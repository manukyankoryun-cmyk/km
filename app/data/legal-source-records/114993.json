{"actId":"114993","text":"ՀԱՅԱՍՏԱՆԻ ՀԱՆՐԱՊԵՏՈՒԹՅԱՆ ԿԱՌԱՎԱՐՈՒԹՅՈՒՆ\n\nՈ Ր Ո Շ ՈՒ Մ\n\n27 հուլիսի 2017 թվականի N 878-Ա\n\nՎԱՐՏԱՆ ԲԱՅԱՆԴՈՒՐՅԱՆԻՆ ՊԱՐՏԱԴԻՐ ԶԻՆՎՈՐԱԿԱՆ ԾԱՌԱՅՈՒԹՅԱՆ ԶՈՐԱԿՈՉԻՑ ՏԱՐԿԵՏՈՒՄ ՏԱԼՈՒ ՄԱՍԻՆ\n\nՀամաձայն «Զինապարտության մասին» Հայաստանի Հանրապետության օրենքի 16-րդ հոդվածի 2-րդ մասի` Հայաստանի Հանրապետության կառավարությունը որոշում է.\n\nՎարտան Սարկիսի Բայանդուրյանին (ծնվ.` 1993 թվականի սեպտեմբերի 20-ին, հասցեն՝ քաղ. Երևան, Աբովյան 9) պարտադիր զինվորական ծառայության զորակոչից տալ տարկետում՝ մինչև 2020 թվականի ամառային զորակոչը ներառյալ։\n\n\n\n\n\nՀայաստանի Հանրապետության վարչապետ\n \nԿ. Կարապետյան\n\n\n\n\n\n\n\n\n\n\n\n\n\n 2017 թ. հուլիսի 27 \nԵրևան\n ","source":"https://www.arlis.am/hy/acts/114993/latest","importedAt":"2026-10-02T14:19:57.027862+00:00","cleaned":true,"verification":{"checkedAt":"2026-10-02T14:19:57.027862+00:00","sourceUrl":"https://www.arlis.am/hy/acts/114993/latest","resolvedActId":"114993","sourceBodySha256":"13b0e0c7897aa23d4601a0d3e986790ee9bca588fb3ffc1b95cd5aea14ba97a9","previousTextSha256":"e2087deee824392de6535dfe72872361ea2489ba21221049c412972ed118fe16","textSha256":"205c57b2abf638bbbd9c8bac3d4dfcea7ca4296aabb6d5e2b6de2e4a80134533","comparison":"same_normalized_text","scope":"Published ARLIS latest HTML body; linked files and later legal changes are not implied verified","sourceStatus":"Գործում է (28.07.2017-մինչ օրս)","tableCount":1,"cellCount":3},"meta":{"number":"N 878-Ա","type":"Որոշում","documentType":"Հիմնական ակտ","status":"Գործում է (28.07.2017-մինչ օրս)","gazette":"Չի հրապարակվել պաշտոնական պարբերականում","adoptedBy":"ՀՀ կառավարություն","adoptedDate":"27.07.2017","signedDate":"27.07.2017","inForceDate":"28.07.2017"},"editionDate":"28.07.2017","docNumber":"N 878-Ա","starts":[0],"blocks":[{"start":0,"end":39,"level":0},{"start":41,"end":53,"level":0},{"start":55,"end":86,"level":0},{"start":88,"end":173,"level":0},{"start":175,"end":315,"level":0},{"start":317,"end":519,"level":0},{"start":521,"end":616,"level":0}],