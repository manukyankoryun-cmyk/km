# --- Secrets / local keys (original project rules; never commit) ---
KM_MASTER_KEYS.txt
_KM_SECURITY_KEYS_SUMMARY.txt
app/km_gemini_keys.local.json
km_install_secret.json
km_integrity_local.json
km_recovery.json
KM_RECOVERY_CODE.txt
app/_new_keys.json
*.enc.bak
.env
.env.*
!.env.example

# --- Excluded at the owner's request ---
/dist/
/payload/
/project-data/UserData/BotKnowledge/
kod_codes.txt

# --- Reinstallable / build artifacts / junk ---
node_modules/
_cache/
_bytecode_out/
_bytecode_hot/
*.log

# --- Access-code lists (secrets: unit login codes) ---
/kodmutq/
/app/data/unit_kod_seed/

# --- Personal data held back (repo is PUBLIC; not yet approved for publishing) ---
# Personnel records (names, ranks, posts, birth dates, addresses, passport data, ...)
/app/data/unit_archives_seed/
/project-data/UserData/database_snapshot.json
/project-data/UserData/database_snapshot.json.bak_*
/project-data/UserData/Backups/
# LAN sync outbox / archive transfers (contain personnel records)
/project-data/UserData/KM_Net/outbox/
/project-data/UserData/KM_Net/archive/
# Accounts, audit log, license, login guard, security, settings, install, LAN config
/project-data/UserData/km_app_users.json
/project-data/UserData/km_audit.jsonl
/project-data/UserData/km_license.json
/project-data/UserData/km_login_guard.json
/project-data/UserData/km_security.json
/project-data/UserData/km_settings.json
/project-data/UserData/km_install.json
/project-data/UserData/km_lan_config.json

